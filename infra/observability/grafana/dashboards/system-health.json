{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "System Health Overview",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "up{job=\"ground-api\"}",
          "legendFormat": "Ground API"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "description": "Service health status [REQ-OPS-OBSERVABILITY]"
    },
    {
      "title": "CPU Temperature (°C)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "asterion_flight_cpu_temp_celsius",
          "legendFormat": "CPU Temp"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 75 }
            ]
          }
        }
      },
      "description": "Flight Segment CPU temperature with SAFE threshold at 75°C"
    },
    {
      "title": "Command Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, asterion_command_latency_seconds_bucket)",
          "legendFormat": "p95 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1.5 },
              { "color": "red", "value": 2.0 }
            ]
          }
        }
      },
      "description": "Command execution latency p95 [REQ-COM-P95: target ≤ 2s]"
    },
    {
      "title": "Fault Recovery Timeline",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "asterion_watchdog_recovery_seconds",
          "legendFormat": "Recovery Time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 3.0 }
            ]
          }
        }
      },
      "description": "Watchdog recovery time [REQ-FSW-WD-03s: target ≤ 3s]"
    },
    {
      "title": "Store-and-Forward Queue Depth",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "asterion_disk_queue_depth",
          "legendFormat": "Queue Depth"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 100 }
            ]
          }
        }
      },
      "description": "Messages queued during outage [REQ-COM-ZERO-LOSS]"
    },
    {
      "title": "Twin Prediction Lead Time",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "asterion_twin_lead_time_minutes",
          "legendFormat": "Lead Time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "m",
          "min": 0,
          "max": 30,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 15 }
            ]
          }
        }
      },
      "description": "Digital Twin prediction lead time [REQ-DT-EARLY-15m: target ≥ 15 min]"
    },
    {
      "title": "Battery SOC (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "asterion_flight_battery_soc * 100",
          "legendFormat": "SOC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 15 },
              { "color": "green", "value": 30 }
            ]
          }
        }
      },
      "description": "Battery State of Charge"
    }
  ],
  "schemaVersion": 39,
  "tags": ["asterion", "flight", "ground", "twin"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "Asterion One — System Health",
  "uid": "asterion-health",
  "version": 1
}